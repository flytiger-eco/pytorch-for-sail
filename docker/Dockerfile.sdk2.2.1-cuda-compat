# Builds PyTorch-for-SAIL v2.14.1 (CUDA-compat mode) from source with the
# Flytiger PPU SDK v2.2.1 image.
# The build context must be the assembled CUDA-compat source tree produced by
# scripts/setup.sh (v2.14.1 upstream + the compat patch series + all
# submodules initialized).
ARG BASE_IMAGE=pkg.flytiger-eco.com/docker_release/ppu:sdk2.2.1-cuda13.0-ubuntu24-py312-20261103
FROM ${BASE_IMAGE} AS build

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG BUILD_ENVIRONMENT=ubuntu-ppu-sdk2.2.1-cuda-compat
ARG MAX_JOBS=128
ARG PYTORCH_BUILD_VERSION=2.14.1
ARG PYTORCH_BUILD_NUMBER=0
# Default "8.0a;8.9" covers the SM80 family (arch-accelerated) and SM89;
# override with --build-arg TORCH_CUDA_ARCH_LIST=<arch> for a single arch.
ARG TORCH_CUDA_ARCH_LIST="8.0a;8.9"
ARG USE_FLASH_ATTENTION=True
# Heavyweight optional backends, OFF by default to keep the build fast.
# Pass --build-arg USE_FLEX_FLASH_ATTENTION=1 (or USE_ELEMENTWISE_OPT=1)
# to enable the FA3 flex-attention / elementwise-optimized backends.
ARG USE_FLEX_FLASH_ATTENTION=0
ARG USE_ELEMENTWISE_OPT=0
ARG PIP_INDEX_URL=https://pypi.org/simple
# SDK v2.2.1 ships PCCL (and its NCCL compatibility wrapper) as a package
# decoupled from the SDK.  Builders may pass NCCL_PACKAGE_URL (with its
# NCCL_PACKAGE_SHA256) via --build-arg to install a matching tarball; when
# left empty, the build falls back to the copy pre-installed in the base
# image.
ARG NCCL_PACKAGE_URL=
ARG NCCL_PACKAGE_SHA256=93513c25af1a5c94ccc38483261b23de6e4912763c3a589e60b1f8dd86cc7a02

LABEL org.opencontainers.image.title="PyTorch-for-SAIL v2.14.1 CUDA-compat build image" \
      org.opencontainers.image.description="Builds and verifies the PyTorch-for-SAIL v2.14.1 CUDA-compat wheel with PPU SDK v2.2.1"

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_ROOT_USER_ACTION=ignore \
    BUILD_ENVIRONMENT=${BUILD_ENVIRONMENT} \
    PPU_SDK=/usr/local/PPU_SDK \
    PPU_PATH=/usr/local/PPU_SDK \
    PPU_HOME=/usr/local/PPU_SDK \
    PPU_TARGET=x86_64-linux \
    PPU_INCLUDE_DIR=/usr/local/PPU_SDK/targets/x86_64-linux/include \
    PPU_LIBRARY_DIR=/usr/local/PPU_SDK/targets/x86_64-linux/lib \
    CUDA_SDK=/usr/local/PPU_SDK/CUDA_SDK \
    CUDA_TOOLKIT_ROOT=/usr/local/PPU_SDK/CUDA_SDK \
    CUDA_PATH=/usr/local/PPU_SDK/CUDA_SDK \
    CUDA_HOME=/usr/local/PPU_SDK/CUDA_SDK \
    CUDACXX=/usr/local/PPU_SDK/CUDA_SDK/bin/nvcc \
    PCCL_HOME=/usr/local/pccl \
    PCCL_PATH=/usr/local/pccl \
    NCCL_HOME=/usr/local/pccl/nccl_wrapper \
    NCCL_PATH=/usr/local/pccl/nccl_wrapper \
    NCCL_INCLUDE_DIR=/usr/local/pccl/nccl_wrapper/include \
    NCCL_LIB_DIR=/usr/local/pccl/nccl_wrapper/lib \
    MAX_JOBS=${MAX_JOBS} \
    PYTORCH_VERSION=${PYTORCH_BUILD_VERSION} \
    PYTORCH_BUILD_VERSION=${PYTORCH_BUILD_VERSION} \
    PYTORCH_BUILD_NUMBER=${PYTORCH_BUILD_NUMBER} \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    PYTORCH_SAIL_ARCH=ppu_10;ppu_15 \
    USE_FLASH_ATTENTION=${USE_FLASH_ATTENTION} \
    USE_FLEX_FLASH_ATTENTION=${USE_FLEX_FLASH_ATTENTION} \
    USE_ELEMENTWISE_OPT=${USE_ELEMENTWISE_OPT} \
    USE_SAIL=0 \
    USE_PPU=1 \
    USE_CUDA=1 \
    USE_PCCL=0 \
    USE_NCCL=1 \
    USE_SYSTEM_NCCL=1 \
    BUILD_CAFFE2=False \
    BUILD_TEST=0

ENV PATH=/usr/local/pccl/bin:/usr/local/PPU_SDK/ppu-smi/bin:/usr/local/PPU_SDK/asight/bin:/usr/local/PPU_SDK/CUDA_SDK/bin:/usr/local/PPU_SDK/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/pccl/nccl_wrapper/lib:/usr/local/pccl/lib:/usr/local/PPU_SDK/ppu-smi/lib:/usr/local/PPU_SDK/targets/x86_64-linux/lib:/usr/local/PPU_SDK/CUDA_SDK/lib64:/usr/local/PPU_SDK/lib:${LD_LIBRARY_PATH} \
    LIBRARY_PATH=/usr/local/pccl/nccl_wrapper/lib:/usr/local/pccl/lib:/usr/local/PPU_SDK/targets/x86_64-linux/lib:/usr/local/PPU_SDK/CUDA_SDK/lib64:/usr/local/PPU_SDK/lib:${LIBRARY_PATH} \
    PYTHONPATH=/usr/local/lib/python3.12/site-packages:/usr/lib/python3/dist-packages:${PYTHONPATH}

RUN --mount=type=cache,target=/var/cache/apt,id=pytorch-sail-sdk221-compat-apt \
    apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      ccache \
      cmake \
      curl \
      git \
      libffi-dev \
      libgflags-dev \
      libgoogle-glog-dev \
      libjpeg-dev \
      libopenblas-dev \
      libpng-dev \
      libprotobuf-dev \
      libssl-dev \
      libsndfile1-dev \
      ninja-build \
      patch \
      pkg-config \
      protobuf-compiler \
      python3-dev \
      python3-packaging \
      python3-pip \
      python3-pytest \
      python3-requests \
      python3-six \
      python3-typing-extensions \
      python3-yaml \
    && rm -rf /var/lib/apt/lists/*

# Install the decoupled PCCL/NCCL package before copying the source tree.
# The tarball extracts a top-level pccl/ directory into /usr/local (-> /usr/local/pccl),
# which provides both the PCCL library and its NCCL compatibility wrapper.
# When the package URL is not reachable from the build network, fall back to the identical
# copy pre-installed in the base image, then validate the required SDK/PCCL/NCCL artifacts.
RUN set -eux; \
    tmp="$(mktemp -d)"; \
    if [ -n "${NCCL_PACKAGE_URL}" ] && curl -fL --retry 3 --retry-delay 2 --max-time 900 "${NCCL_PACKAGE_URL}" -o "${tmp}/pccl.tar.gz"; then \
      echo "${NCCL_PACKAGE_SHA256}  ${tmp}/pccl.tar.gz" | sha256sum -c -; \
      tar xzf "${tmp}/pccl.tar.gz" -C /usr/local; \
      echo "Installed the PCCL/NCCL package from the configured URL"; \
    else \
      echo "PCCL/NCCL package URL not set or download failed; using the copy pre-installed in the base image"; \
    fi; \
    rm -rf "${tmp}"; \
    source "${PPU_SDK}/envsetup.sh" >/dev/null; \
    source "${PCCL_HOME}/envsetup.sh" >/dev/null; \
    hgcc --version | grep -q 'Release version 2\.2\.'; \
    test -f "${PCCL_HOME}/release.yaml"; \
    test -f "${PCCL_HOME}/include/pccl.h"; \
    test -e "${PCCL_HOME}/lib/libpccl.so"; \
    test -f "${NCCL_HOME}/include/nccl.h"; \
    test -e "${NCCL_HOME}/lib/libnccl.so"; \
    cmake --version; \
    ninja --version; \
    ccache --version

WORKDIR /workspace/pytorch
COPY . .

# Build through the PEP 517 frontend while reusing the explicitly installed
# build environment.  The CUDA-compat third-party conversion
# (tools/cudafy_compat) runs automatically at CMake configure time.
RUN --mount=type=cache,target=/root/.cache/pip,id=pytorch-sail-sdk221-compat-pip \
    set -eux; \
    test -f third_party/flash-attention-for-sail/setup.py; \
    test -f third_party/flex-flash-attention/build_lib.py; \
    test -f third_party/cutlass/include/cutlass/cutlass.h; \
    test -f third_party/cudafy-for-sail/cudafy.py; \
    test -f third_party/xformers/setup.py; \
    rm -rf build dist; \
    for optional_submodule in aiter composable_kernel; do \
      mkdir -p "third_party/${optional_submodule}"; \
      if [[ ! -f "third_party/${optional_submodule}/CMakeLists.txt" ]]; then \
        printf 'cmake_minimum_required(VERSION 3.27)\nproject(optional_rocm_stub NONE)\n' \
          > "third_party/${optional_submodule}/CMakeLists.txt"; \
      fi; \
    done; \
    # Never --upgrade packages provided by apt (python3-typing-extensions,
    # python3-yaml, python3-packaging install into /usr/lib/python3/dist-packages
    # without RECORD files, so any uninstall attempt fails).  Overlay the two
    # packages whose floors exceed the Ubuntu 24.04 apt versions with
    # --ignore-installed instead: they land in site-packages, which takes
    # precedence on sys.path.
    PIP_INDEX_URL="${PIP_INDEX_URL}" python3 -m pip install \
      'scikit-build-core>=1.0' sympy networkx; \
    PIP_INDEX_URL="${PIP_INDEX_URL}" python3 -m pip install --ignore-installed \
      'packaging>=24.2' 'typing-extensions>=4.15,<5'; \
    python3 -c 'import numpy, packaging, requests, six, typing_extensions, yaml; from importlib.metadata import version; from packaging.version import Version; assert Version("70.1.0") <= Version(version("setuptools")) < Version("82"); assert Version(version("packaging")) >= Version("24.2"); assert Version(version("typing_extensions")) >= Version("4.15.0")'; \
    source "${PPU_SDK}/envsetup.sh" >/dev/null; \
    source "${PCCL_HOME}/envsetup.sh" >/dev/null; \
    export NCCL_INCLUDE_DIR="${NCCL_HOME}/include" NCCL_LIB_DIR="${NCCL_HOME}/lib"; \
    export PYTHONPATH="/workspace/pytorch:${PYTHONPATH}"; \
    python3 -m pip wheel --no-build-isolation --no-deps -w dist .; \
    wheel=(dist/torch-*.whl); \
    test -f "${wheel[0]}"; \
    mkdir -p /opt/artifacts; \
    cp "${wheel[0]}" /opt/artifacts/; \
    PIP_INDEX_URL="${PIP_INDEX_URL}" python3 -m pip install "numpy<2" --force-reinstall; \
    PIP_INDEX_URL="${PIP_INDEX_URL}" python3 -m pip install --force-reinstall --no-deps "${wheel[0]}"; \
    cd /tmp; \
    unset PYTHONPATH; \
    python3 -c 'import sys, torch; compiled = torch.cuda._is_compiled(); print(f"torch-version={torch.__version__}"); print(f"torch-cuda-version={torch.version.cuda}"); print(f"torch-cuda-compiled={compiled}"); sys.exit(0 if compiled else "torch was built without CUDA support")'; \
    python3 -c 'import torch; print(f"nccl-version={torch.cuda.nccl.version()}")'; \
    ldd "$(python3 -c 'import torch, os; print(os.path.dirname(torch.__file__))')/lib/libtorch_cuda.so" | grep -i nccl

FROM scratch AS artifact
COPY --from=build /opt/artifacts/ /

FROM build AS runtime
WORKDIR /workspace
CMD ["bash"]
