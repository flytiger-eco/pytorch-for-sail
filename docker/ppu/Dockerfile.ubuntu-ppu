# syntax=docker/dockerfile:1
#
# Builds PyTorch-for-SAIL 2.13.0 from source inside the Flytiger PPU SDK 2.2.0 image.
#
# The build context MUST be the PyTorch-for-SAIL repository root and MUST include the
# initialized PPU submodules; this image never fetches submodules over the network.
#
# Compared with the v2.11 Dockerfile.ubuntu-ppu, this version does NOT hardcode the
# SDK / NCCL paths. PPU SDK 2.2 moved the NCCL wrapper out of CUDA_SDK into a sibling
# /usr/local/pccl tree, so the build is delegated to the repository's own CI scripts
# (.ci/ppu/build_wheel.sh -> sdk_env.sh + nccl_env.sh + ccache_env.sh), which resolve
# NCCL_HOME / NCCL_INCLUDE_DIR / NCCL_LIB_DIR from the pccl envsetup and are the exact
# path exercised by .github/workflows/_ppu_build.yml.

# NOTE: Building this image requires docker version >= 23.0 (BuildKit).
ARG BASE_IMAGE=pkg.flytiger-eco.com/docker_release/ppu:sdk2.2.0-cuda13.0-ubuntu24-py312-20261001

FROM ${BASE_IMAGE} AS build

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Build options. Defaults mirror .github/workflows/_ppu_build.yml and .ci/ppu/build_wheel.sh.
ARG BUILD_ENVIRONMENT=ubuntu-ppu
# PPU toolchain semantics: 8.0a = SM80 only, 8.9 = SM89 only, "8.0a;8.9" = mixed SM80+SM89.
# Override to a single arch (8.0 or 8.9) to roughly halve the compile time.
ARG TORCH_CUDA_ARCH_LIST=8.0a;8.9
# 0 lets build_wheel.sh derive MAX_JOBS from nproc and available memory.
ARG MAX_JOBS=0
ARG PPU_LINK_JOBS=2
ARG PPU_MEM_PER_JOB_GB=4
ARG SDK_INSTALL_DIR=/usr/local
ARG PYTORCH_BUILD_VERSION=2.13.0
ARG PIP_INDEX_URL=https://pypi.org/simple

LABEL org.opencontainers.image.title="PyTorch-for-SAIL 2.13.0 ubuntu-ppu build image" \
      org.opencontainers.image.description="Builds and verifies a PyTorch-for-SAIL 2.13.0 wheel with the PPU SDK 2.2.0"

ENV DEBIAN_FRONTEND=noninteractive \
    BUILD_ENVIRONMENT=${BUILD_ENVIRONMENT} \
    SDK_INSTALL_DIR=${SDK_INSTALL_DIR} \
    REPO_DIR=/workspace/pytorch-for-sail \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    MAX_JOBS=${MAX_JOBS} \
    PPU_LINK_JOBS=${PPU_LINK_JOBS} \
    PPU_MEM_PER_JOB_GB=${PPU_MEM_PER_JOB_GB} \
    PYTORCH_BUILD_VERSION=${PYTORCH_BUILD_VERSION} \
    PIP_INDEX_URL=${PIP_INDEX_URL}

# Host toolchain. cmake (==3.31.10) and the Python build deps are installed by
# .ci/ppu/build_wheel.sh, so only the compiler, downloaders and -dev libraries are
# installed here. wget/curl are required by install_sdk.sh / install_nccl.sh when the
# base image does not already bundle the SDK or the pccl NCCL wrapper.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      ccache \
      curl \
      wget \
      git \
      pkg-config \
      libffi-dev \
      libgflags-dev \
      libgoogle-glog-dev \
      libjpeg-dev \
      libopenblas-dev \
      libpng-dev \
      libprotobuf-dev \
      libssl-dev \
      libsndfile1-dev \
      protobuf-compiler \
      python3-dev \
      python3-pip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/pytorch-for-sail
COPY . .

# Fail fast, before the multi-hour compile, if the build context is missing a PPU source
# library. v2.13.0 needs five PPU submodules, and setup.py hard-requires the nested
# csrc/actlize inside flex-flash-attention (its gitlink differs from cutlass' actlize).
RUN set -eux; \
    for sm in cutlass flash-attention xformers cudafy-for-sail flex-flash-attention; do \
      if [[ -z "$(ls -A "third_party/${sm}" 2>/dev/null)" ]]; then \
        echo "ERROR: PPU submodule third_party/${sm} is empty; run 'git submodule update --init --recursive' before docker build" >&2; \
        exit 1; \
      fi; \
    done; \
    if [[ -z "$(ls -A third_party/flex-flash-attention/csrc/actlize 2>/dev/null)" ]]; then \
      echo "ERROR: third_party/flex-flash-attention/csrc/actlize is empty; initialize the nested submodule before docker build" >&2; \
      exit 1; \
    fi

# Build the wheel via the CI script, install it, then verify torch imports with CUDA
# support compiled in from outside the source tree.
#
# - /tmp/ppu_source_commit seeds the build-wheel stamp key so build_wheel.sh does not
#   depend on git metadata being present in the image (it reads that file first).
# - build_wheel.sh sources sdk_env.sh + nccl_env.sh + ccache_env.sh, installs the pinned
#   cmake and requirements.txt, then runs setup.py bdist_wheel with the PPU build flags.
RUN set -eux; \
    rm -rf build dist; \
    { git rev-parse --short=7 HEAD 2>/dev/null || echo "${PYTORCH_BUILD_VERSION}"; } > /tmp/ppu_source_commit; \
    bash .ci/ppu/build_wheel.sh; \
    wheel=(dist/torch-*.whl); \
    test -f "${wheel[0]}"; \
    mkdir -p /opt/artifacts; \
    cp "${wheel[0]}" /opt/artifacts/; \
    python3 -m pip install --no-cache-dir --force-reinstall "${wheel[0]}"; \
    cd /tmp; \
    python3 -c 'import sys, torch; compiled = torch.cuda._is_compiled(); print(f"torch-version={torch.__version__}"); print(f"torch-cuda-compiled={compiled}"); sys.exit(0 if compiled else "torch was built without CUDA support")'

# Export just the wheel with `--target artifact` and BuildKit `--output`.
FROM scratch AS artifact
COPY --from=build /opt/artifacts/ /

# Keep the full build environment in the default target for testing in a PPU container.
FROM build AS runtime
WORKDIR /workspace
CMD ["bash"]
