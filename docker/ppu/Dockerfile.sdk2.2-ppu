# Builds PyTorch-for-SAIL 2.11 from source with the Flytiger PPU SDK v2.2 image.
# The build context must be the repository root with all submodules initialized.
ARG BASE_IMAGE=pkg.flytiger-eco.com/docker_release/ppu:sdk2.2.0-cuda13.0-ubuntu24-py312-20261001@sha256:f7b4a1c63ffb2f89f53aaa89c9445e46b2a2b8821fddebca3b396ee6bb324f3a
FROM ${BASE_IMAGE} AS build

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG BUILD_ENVIRONMENT=ubuntu-ppu-sdk2.2
ARG MAX_JOBS=32
ARG PYTORCH_BUILD_VERSION=2.11.0
ARG PYTORCH_BUILD_NUMBER=0
# Default "8.0a;8.9" builds for all supported Zhenwu boards (SM80 family + SM89);
# override with --build-arg TORCH_CUDA_ARCH_LIST=<arch> to target a single arch.
ARG TORCH_CUDA_ARCH_LIST=8.0a;8.9
ARG USE_FLASH_ATTENTION=True
ARG USE_FLEX_FLASH_ATTENTION=True
ARG USE_MEM_EFF_ATTENTION=True
ARG USE_ELEMENTWISE_OPT=True
ARG BUILD_TEST=True
ARG PIP_INDEX_URL=https://pypi.org/simple
# SDK v2.2 ships PCCL (and its NCCL compatibility wrapper) as a package decoupled from the SDK.
# NCCL_PACKAGE_URL points at the matching PCCL/NCCL tarball; NCCL_PACKAGE_SHA256 pins its content.
ARG NCCL_PACKAGE_URL=https://pkg.flytiger-eco.com/artifactory/generic-local/NCCL/v2.2.0/nccl-2.27.3-v13_ubuntu2404_sdk-v2.2.0.tar.gz
ARG NCCL_PACKAGE_SHA256=800047b5f6165559a0c1ede90ab7008b598f94de38cef163f44260a0912752f6

LABEL org.opencontainers.image.title="PyTorch-for-SAIL SDK v2.2 PPU build image" \
      org.opencontainers.image.description="Builds and verifies PyTorch-for-SAIL 2.11 with PPU SDK v2.2"

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_ROOT_USER_ACTION=ignore \
    BUILD_ENVIRONMENT=${BUILD_ENVIRONMENT} \
    PPU_SDK=/usr/local/PPU_SDK \
    PPU_PATH=/usr/local/PPU_SDK \
    PPU_HOME=/usr/local/PPU_SDK \
    PPU_TARGET=x86_64-linux \
    PPU_INCLUDE_DIR=/usr/local/PPU_SDK/targets/x86_64-linux/include \
    PPU_LIBRARY_DIR=/usr/local/PPU_SDK/targets/x86_64-linux/lib \
    CUDA_SDK=/usr/local/PPU_SDK/CUDA_SDK \
    CUDA_TOOLKIT_ROOT=/usr/local/PPU_SDK/CUDA_SDK \
    CUDA_PATH=/usr/local/PPU_SDK/CUDA_SDK \
    CUDA_HOME=/usr/local/PPU_SDK/CUDA_SDK \
    CUDACXX=/usr/local/PPU_SDK/CUDA_SDK/bin/nvcc \
    PCCL_HOME=/usr/local/pccl \
    PCCL_PATH=/usr/local/pccl \
    NCCL_HOME=/usr/local/pccl/nccl_wrapper \
    NCCL_PATH=/usr/local/pccl/nccl_wrapper \
    NCCL_INCLUDE_DIR=/usr/local/pccl/nccl_wrapper/include \
    NCCL_LIB_DIR=/usr/local/pccl/nccl_wrapper/lib \
    MAX_JOBS=${MAX_JOBS} \
    PYTORCH_VERSION=${PYTORCH_BUILD_VERSION} \
    PYTORCH_BUILD_VERSION=${PYTORCH_BUILD_VERSION} \
    PYTORCH_BUILD_NUMBER=${PYTORCH_BUILD_NUMBER} \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    USE_FLASH_ATTENTION=${USE_FLASH_ATTENTION} \
    USE_FLEX_FLASH_ATTENTION=${USE_FLEX_FLASH_ATTENTION} \
    USE_MEM_EFF_ATTENTION=${USE_MEM_EFF_ATTENTION} \
    USE_ELEMENTWISE_OPT=${USE_ELEMENTWISE_OPT} \
    USE_NCCL=True \
    USE_DISTRIBUTED=True \
    USE_SYSTEM_NCCL=1 \
    BUILD_CAFFE2=False \
    BUILD_TEST=${BUILD_TEST}

ENV PATH=/usr/local/pccl/bin:/usr/local/PPU_SDK/ppu-smi/bin:/usr/local/PPU_SDK/asight/bin:/usr/local/PPU_SDK/CUDA_SDK/bin:/usr/local/PPU_SDK/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/pccl/nccl_wrapper/lib:/usr/local/pccl/lib:/usr/local/PPU_SDK/ppu-smi/lib:/usr/local/PPU_SDK/targets/x86_64-linux/lib:/usr/local/PPU_SDK/CUDA_SDK/lib64:/usr/local/PPU_SDK/lib:${LD_LIBRARY_PATH} \
    LIBRARY_PATH=/usr/local/pccl/nccl_wrapper/lib:/usr/local/pccl/lib:/usr/local/PPU_SDK/targets/x86_64-linux/lib:/usr/local/PPU_SDK/CUDA_SDK/lib64:/usr/local/PPU_SDK/lib:${LIBRARY_PATH} \
    PYTHONPATH=/usr/local/lib/python3.12/site-packages:/usr/lib/python3/dist-packages:${PYTHONPATH}

RUN --mount=type=cache,target=/var/cache/apt,id=pytorch-sail-sdk22-apt \
    apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      ccache \
      cmake \
      curl \
      git \
      libffi-dev \
      libgflags-dev \
      libgoogle-glog-dev \
      libjpeg-dev \
      libopenblas-dev \
      libpng-dev \
      libprotobuf-dev \
      libssl-dev \
      libsndfile1-dev \
      ninja-build \
      patch \
      pkg-config \
      protobuf-compiler \
      python3-dev \
      python3-packaging \
      python3-pip \
      python3-pytest \
      python3-requests \
      python3-six \
      python3-typing-extensions \
      python3-yaml \
    && rm -rf /var/lib/apt/lists/*

# Install the decoupled PCCL/NCCL package before copying the source tree.
# The tarball extracts a top-level pccl/ directory into /usr/local (-> /usr/local/pccl),
# which provides both the native PCCL layer and the NCCL compatibility wrapper.
# When the package URL is not reachable from the build network, fall back to the identical
# copy pre-installed in the base image, then validate the required SDK/PCCL/NCCL artifacts.
RUN set -eux; \
    tmp="$(mktemp -d)"; \
    if curl -fL --retry 3 --retry-delay 2 --max-time 900 "${NCCL_PACKAGE_URL}" -o "${tmp}/pccl.tar.gz"; then \
      echo "${NCCL_PACKAGE_SHA256}  ${tmp}/pccl.tar.gz" | sha256sum -c -; \
      tar xzf "${tmp}/pccl.tar.gz" -C /usr/local; \
      echo "Installed the PCCL/NCCL package from the configured URL"; \
    else \
      echo "PCCL/NCCL package download failed; using the copy pre-installed in the base image"; \
    fi; \
    rm -rf "${tmp}"; \
    source "${PPU_SDK}/envsetup.sh" >/dev/null; \
    source "${PCCL_HOME}/envsetup.sh" >/dev/null; \
    hgcc --version | grep -q 'Release version 2\.2\.0'; \
    test -f "${PCCL_HOME}/release.yaml"; \
    test -f "${PCCL_HOME}/include/pccl.h"; \
    test -e "${PCCL_HOME}/lib/libpccl.so"; \
    test -f "${NCCL_HOME}/include/nccl.h"; \
    test -e "${NCCL_HOME}/lib/libnccl.so"; \
    cmake --version; \
    ninja --version; \
    ccache --version

WORKDIR /workspace/pytorch-for-sail
COPY . .

# Build through the PEP 517 frontend while reusing the explicitly installed build environment.
RUN --mount=type=cache,target=/root/.cache/pip,id=pytorch-sail-sdk22-pip \
    set -eux; \
    test -f third_party/flash-attention/setup.py; \
    test -f third_party/flex-flash-attention/build_lib.py; \
    test -f third_party/cutlass/include/cutlass/cutlass.h; \
    test -f third_party/cudafy-for-sail/cudafy.py; \
    test -f third_party/xformers/setup.py; \
    rm -rf build dist; \
    for optional_submodule in aiter composable_kernel; do \
      mkdir -p "third_party/${optional_submodule}"; \
      if [[ ! -f "third_party/${optional_submodule}/CMakeLists.txt" ]]; then \
        printf 'cmake_minimum_required(VERSION 3.27)\nproject(optional_rocm_stub NONE)\n' \
          > "third_party/${optional_submodule}/CMakeLists.txt"; \
      fi; \
    done; \
    PIP_INDEX_URL="${PIP_INDEX_URL}" python3 -m pip install --ignore-installed 'typing-extensions>=4.15,<5'; \
    python3 -c 'import numpy, packaging, requests, six, typing_extensions, yaml; from importlib.metadata import version; from packaging.version import Version; assert Version("70.1.0") <= Version(version("setuptools")) < Version("82"); assert Version(version("typing_extensions")) >= Version("4.15.0")'; \
    source "${PPU_SDK}/envsetup.sh" >/dev/null; \
    source "${PCCL_HOME}/envsetup.sh" >/dev/null; \
    export NCCL_INCLUDE_DIR="${NCCL_HOME}/include" NCCL_LIB_DIR="${NCCL_HOME}/lib"; \
    python3 -m pip wheel --no-build-isolation --no-deps -w dist .; \
    wheel=(dist/torch-*.whl); \
    test -f "${wheel[0]}"; \
    mkdir -p /opt/artifacts; \
    cp "${wheel[0]}" /opt/artifacts/; \
    PIP_INDEX_URL="${PIP_INDEX_URL}" python3 -m pip install --force-reinstall "${wheel[0]}"; \
    cd /tmp; \
    python3 -c 'import sys, torch; compiled = torch.cuda._is_compiled(); print(f"torch-version={torch.__version__}"); print(f"torch-cuda-compiled={compiled}"); sys.exit(0 if compiled else "torch was built without CUDA support")'

FROM scratch AS artifact
COPY --from=build /opt/artifacts/ /

FROM build AS runtime
WORKDIR /workspace
CMD ["bash"]
