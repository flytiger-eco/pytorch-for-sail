+# --------------------------------------------------------------------------
+# B. can_use REJECT branches (forced backend must raise, no silent fallback)
+# --------------------------------------------------------------------------
+class TestCanUseReject:
+    def _expect_reject(self, q, k, v, mask=None, dropout_p=0.0,
+                       is_causal=False):
+        with pytest.raises(RuntimeError):
