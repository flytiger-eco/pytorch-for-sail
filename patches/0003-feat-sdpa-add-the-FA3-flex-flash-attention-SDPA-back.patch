+_ENV_KILL_PROBE = r"""
+import torch
+import torch.nn.functional as F
+from torch.nn.attention import SDPBackend, sdpa_kernel
+
+print("DEFAULT_ENABLED:", torch.backends.cuda.flex_flash_attention_sdp_enabled())
