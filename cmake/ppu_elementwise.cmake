# Configure a launcher here, or replay SDK stages when invoked with cmake -P.
if(NOT CMAKE_SCRIPT_MODE_FILE)
  function(torch_ppu_elementwise_launcher target)
    if(NOT USE_PPU OR NOT USE_ELEMENTWISE_OPT)
      return()
    endif()
    set(_script "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    set(_prefix "${CMAKE_CURRENT_BINARY_DIR}/ppu_elementwise/${target}_cache_prefix")
    # ccache requires an executable prefix; this build-only shim contains no replay logic.
    string(REPLACE "'" "'\\''" _shell_cmake "${CMAKE_COMMAND}")
    string(REPLACE "'" "'\\''" _shell_script "${_script}")
    file(CONFIGURE OUTPUT "${_prefix}" CONTENT
      "#!/bin/sh\nexec '${_shell_cmake}' -DPPU_ELEMENTWISE_CACHE_MISS=1 -P '${_shell_script}' -- \"$@\"\n"
      @ONLY)
    file(CHMOD "${_prefix}" PERMISSIONS
      OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    get_target_property(_launcher ${target} CUDA_COMPILER_LAUNCHER)
    if(NOT _launcher)
      set(_launcher "")
    endif()
    set_property(TARGET ${target} PROPERTY CUDA_COMPILER_LAUNCHER
      "${CMAKE_COMMAND};-DPPU_ELEMENTWISE_PREFIX=${_prefix};-P;${_script};--;${_launcher}")
    # Launcher changes must also rebuild Ninja objects, not just invalidate the compiler cache.
    get_target_property(_sources ${target} SOURCES)
    foreach(_source IN LISTS _sources)
      if(_source MATCHES "\\.cu$")
        set_property(SOURCE "${_source}" APPEND PROPERTY OBJECT_DEPENDS "${_script}")
      endif()
    endforeach()
  endfunction()
  return()
endif()

cmake_minimum_required(VERSION 3.27)

# Keep literal semicolons escaped while commands travel through CMake lists.
function(_ppu_append name value)
  string(REPLACE ";" "\\;" _value "${value}")
  list(APPEND ${name} "${_value}")
  set(${name} "${${name}}" PARENT_SCOPE)
endfunction()

function(_ppu_option output args name)
  list(FIND ${args} "${name}" _index)
  set(_value "")
  if(NOT _index EQUAL -1)
    math(EXPR _index "${_index} + 1")
    list(LENGTH ${args} _length)
    if(_index GREATER_EQUAL _length)
      message(FATAL_ERROR "Missing value for ${name}")
    endif()
    list(GET ${args} ${_index} _value)
  endif()
  set(${output} "${_value}" PARENT_SCOPE)
endfunction()

function(_ppu_expand_response output args depth)
  if(depth GREATER 32)
    message(FATAL_ERROR "PPU response-file nesting exceeds 32 levels")
  endif()
  set(_expanded "")
  foreach(_arg IN LISTS ${args})
    if(_arg MATCHES "^@(.+)$")
      file(READ "${CMAKE_MATCH_1}" _text)
      separate_arguments(_response UNIX_COMMAND "${_text}")
      math(EXPR _next "${depth} + 1")
      _ppu_expand_response(_response _response ${_next})
      foreach(_item IN LISTS _response)
        _ppu_append(_expanded "${_item}")
      endforeach()
    else()
      _ppu_append(_expanded "${_arg}")
    endif()
  endforeach()
  set(${output} "${_expanded}" PARENT_SCOPE)
endfunction()

# Quoted EVAL arguments preserve empty tokens as well as literal list separators.
function(_ppu_execute output args capture)
  set(_code "execute_process(COMMAND")
  foreach(_arg IN LISTS ${args})
    string(REPLACE "\\" "\\\\" _arg "${_arg}")
    string(REPLACE "$" "\\$" _arg "${_arg}")
    string(REPLACE "\"" "\\\"" _arg "${_arg}")
    string(APPEND _code " \"${_arg}\"")
  endforeach()
  string(APPEND _code " RESULT_VARIABLE _status")
  if(capture)
    string(APPEND _code " OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr")
  endif()
  string(APPEND _code ")")
  cmake_language(EVAL CODE "${_code}")
  set(${output} "${_status}" PARENT_SCOPE)
  if(capture)
    set(${output}_stdout "${_stdout}" PARENT_SCOPE)
    set(${output}_stderr "${_stderr}" PARENT_SCOPE)
  endif()
endfunction()

function(_ppu_finish status)
  if(NOT "${status}" STREQUAL "0")
    # EXIT was added in 3.29; older supported CMake versions still fail loudly.
    if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29 AND "${status}" MATCHES "^[0-9]+$")
      cmake_language(EXIT ${status})
    endif()
    message(FATAL_ERROR "PPU compiler stage failed: ${status}")
  endif()
endfunction()

function(_ppu_parse_plan output text)
  string(REPLACE ";" "\\;" _text "${text}")
  string(REPLACE "\n" ";" _lines "${_text}")
  set(_count 0)
  set(_devices "")
  set(_splitter FALSE)
  set(_fatbinary FALSE)
  foreach(_line IN LISTS _lines)
    if(NOT _line MATCHES "^#\\$ (.*)$")
      continue()
    endif()
    set(_payload "${CMAKE_MATCH_1}")
    if(_payload MATCHES "^-- Merge Dependencies -- (.*) --> (.*)$")
      set(_inputs "${CMAKE_MATCH_1}")
      set(_destination "${CMAKE_MATCH_2}")
      separate_arguments(_args UNIX_COMMAND "${_inputs}")
      separate_arguments(_destination UNIX_COMMAND "${_destination}")
      list(LENGTH _destination _length)
      if(NOT _length EQUAL 1)
        message(FATAL_ERROR "Invalid PPU dependency destination: ${_payload}")
      endif()
      list(GET _destination 0 _destination)
      set(${output}_${_count}_kind dependencies PARENT_SCOPE)
      set(${output}_${_count}_destination "${_destination}" PARENT_SCOPE)
    elseif(_payload MATCHES "^[A-Za-z_][A-Za-z_0-9]*=")
      continue()
    else()
      separate_arguments(_args UNIX_COMMAND "${_payload}")
      if(NOT _args)
        message(FATAL_ERROR "Empty PPU dry-run stage")
      endif()
      list(GET _args 0 _executable)
      get_filename_component(_name "${_executable}" NAME)
      if(NOT IS_ABSOLUTE "${_executable}" AND NOT _name MATCHES "^(g\\+\\+|gcc)$")
        message(FATAL_ERROR "Unknown PPU dry-run stage: ${_payload}")
      endif()
      set(${output}_${_count}_kind command PARENT_SCOPE)
      if("-fcuda-is-device" IN_LIST _args)
        _ppu_option(_cpu _args -target-cpu)
        list(APPEND _devices "${_cpu}")
        if(_cpu STREQUAL "ppu0015")
          list(FIND _args -ppu-arch-list _index)
          if(_index EQUAL -1)
            message(FATAL_ERROR "PPU SDK is missing the independent registration-context option")
          endif()
          _ppu_option(_arch_list _args -ppu-arch-list)
          math(EXPR _index "${_index} + 1")
          list(REMOVE_AT _args ${_index})
          list(INSERT _args ${_index} ppu0015)
        endif()
      endif()
      if("-split-host-code" IN_LIST _args)
        set(_splitter TRUE)
      endif()
      if(_name STREQUAL "hgfatbinary")
        set(_fatbinary TRUE)
      endif()
    endif()
    set(${output}_${_count}_args "${_args}" PARENT_SCOPE)
    math(EXPR _count "${_count} + 1")
  endforeach()
  if(NOT _devices STREQUAL "ppu001;ppu0015")
    message(FATAL_ERROR "PPU SDK device compilation plan changed; refusing objects with missing registrations")
  endif()
  if(NOT _splitter OR NOT _fatbinary)
    message(FATAL_ERROR "Missing PPU host splitter or fatbinary stage")
  endif()
  set(${output}_count ${_count} PARENT_SCOPE)
endfunction()

function(_ppu_run_staged args)
  string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef _nonce)
  if(DEFINED ENV{TMPDIR} AND NOT "$ENV{TMPDIR}" STREQUAL "")
    set(_temporary "$ENV{TMPDIR}")
  else()
    set(_temporary /tmp)
  endif()
  set(_work "${_temporary}/ppu_elementwise_${_nonce}")
  file(MAKE_DIRECTORY "${_work}")
  set(_command "${${args}}")
  set(_keep_dir FALSE)
  foreach(_arg IN LISTS _command)
    if(_arg MATCHES "^--keep-dir(=|$)")
      set(_keep_dir TRUE)
    endif()
  endforeach()
  if(NOT _keep_dir)
    list(APPEND _command --keep --keep-dir "${_work}")
  endif()
  set(_dry_command "${_command}")
  list(APPEND _dry_command --dryrun)
  _ppu_execute(_status _dry_command TRUE)
  if(NOT "${_status}" STREQUAL "0")
    message("${_status_stdout}${_status_stderr}")
    _ppu_finish("${_status}")
  endif()
  # Validate the whole plan before executing any SDK stage.
  _ppu_parse_plan(_plan "${_status_stdout}\n${_status_stderr}")
  math(EXPR _last "${_plan_count} - 1")
  foreach(_index RANGE 0 ${_last})
    set(_stage "${_plan_${_index}_args}")
    if(_plan_${_index}_kind STREQUAL "dependencies")
      set(_merged "")
      set(_seen "")
      list(REMOVE_DUPLICATES _stage)
      foreach(_source IN LISTS _stage)
        string(SHA256 _key "${_source}")
        if(DEFINED _dependencies_${_key})
          set(_snapshots "${_dependencies_${_key}}")
        else()
          set(_snapshots "")
          _ppu_append(_snapshots "${_source}")
        endif()
        foreach(_snapshot IN LISTS _snapshots)
          file(READ "${_snapshot}" _contents)
          string(SHA256 _hash "${_contents}")
          if(NOT _hash IN_LIST _seen)
            list(APPEND _seen "${_hash}")
            string(APPEND _merged "${_contents}\n")
          endif()
        endforeach()
      endforeach()
      file(WRITE "${_plan_${_index}_destination}" "${_merged}")
    else()
      _ppu_execute(_status _stage FALSE)
      _ppu_finish("${_status}")
      _ppu_option(_dependency _stage -MF)
      if(NOT _dependency STREQUAL "")
        # The next device pass can overwrite the same depfile; snapshot it now.
        string(SHA256 _key "${_dependency}")
        set(_snapshot "${_work}/dependency_${_index}")
        file(COPY_FILE "${_dependency}" "${_snapshot}")
        _ppu_append(_dependencies_${_key} "${_snapshot}")
      endif()
    endif()
  endforeach()
  file(REMOVE_RECURSE "${_work}")
endfunction()

# Arguments after -- are compiler arguments, not CMake options.
set(_args "")
set(_compiler_args FALSE)
math(EXPR _last "${CMAKE_ARGC} - 1")
foreach(_index RANGE 0 ${_last})
  if(_compiler_args)
    _ppu_append(_args "${CMAKE_ARGV${_index}}")
  elseif("${CMAKE_ARGV${_index}}" STREQUAL "--")
    set(_compiler_args TRUE)
  endif()
endforeach()
_ppu_expand_response(_args _args 0)
if(NOT _args)
  message(FATAL_ERROR "No CUDA compilation command provided")
endif()

set(_compile FALSE)
if("-c" IN_LIST _args OR "--compile" IN_LIST _args)
  set(_compile TRUE)
endif()
foreach(_flag IN ITEMS -E -M -MM --preprocess --dryrun -dlink --device-link)
  if(_flag IN_LIST _args)
    set(_compile FALSE)
  endif()
endforeach()
if(NOT _compile)
  _ppu_execute(_status _args FALSE)
  _ppu_finish("${_status}")
  return()
endif()

list(GET _args 0 _first)
get_filename_component(_name "${_first}" NAME)
set(_cached FALSE)
set(_command "${_args}")
if(_name STREQUAL "ccache" AND NOT PPU_ELEMENTWISE_CACHE_MISS)
  set(_cached TRUE)
  list(REMOVE_AT _command 0)
endif()
if(NOT _command)
  message(FATAL_ERROR "PPU elementwise compilation requires nvcc, optionally preceded by ccache")
endif()
list(GET _command 0 _compiler)
get_filename_component(_name "${_compiler}" NAME)
if(NOT _name STREQUAL "nvcc")
  message(FATAL_ERROR "PPU elementwise compilation requires nvcc, optionally preceded by ccache")
endif()

set(_arches "")
set(_has_dependencies FALSE)
foreach(_arg IN LISTS _command)
  string(REGEX MATCHALL "arch=compute_[A-Za-z0-9_]+" _targets "${_arg}")
  foreach(_target IN LISTS _targets)
    string(REPLACE "arch=compute_" "" _arch "${_target}")
    if(_arch STREQUAL "80")
      list(APPEND _arches 80a 89)
    else()
      list(APPEND _arches "${_arch}")
    endif()
  endforeach()
  if(_arg MATCHES "^(-MD|-MMD|--generate-dependencies-with-compile)$")
    set(_has_dependencies TRUE)
  endif()
endforeach()
if(NOT _arches)
  message(FATAL_ERROR "PPU elementwise compilation requires explicit compute_80a, compute_89, or compute_80 targets")
endif()
list(REMOVE_DUPLICATES _arches)
foreach(_arch IN LISTS _arches)
  if(NOT _arch MATCHES "^(80a|89)$")
    message(FATAL_ERROR "Unsupported PPU elementwise architecture: ${_arch}")
  endif()
endforeach()
list(LENGTH _arches _arch_count)
if(_arch_count EQUAL 1)
  _ppu_execute(_status _args FALSE)
  _ppu_finish("${_status}")
elseif(_cached AND NOT PPU_ELEMENTWISE_CACHE_MISS)
  if(DEFINED ENV{CCACHE_PREFIX} AND NOT "$ENV{CCACHE_PREFIX}" STREQUAL "")
    message(FATAL_ERROR "PPU elementwise dual-target compilation requires its own CCACHE_PREFIX; unset the existing prefix")
  endif()
  if(_has_dependencies AND EXISTS "${PPU_ELEMENTWISE_PREFIX}"
      AND NOT "${PPU_ELEMENTWISE_PREFIX}" MATCHES "[ \t\r\n]"
      AND NOT "${CMAKE_CURRENT_LIST_FILE}" MATCHES "[ \t\r\n]")
    set(_extras "${CMAKE_CURRENT_LIST_FILE}:${PPU_ELEMENTWISE_PREFIX}")
    if(DEFINED ENV{CCACHE_EXTRAFILES} AND NOT "$ENV{CCACHE_EXTRAFILES}" STREQUAL "")
      string(APPEND _extras ":$ENV{CCACHE_EXTRAFILES}")
    endif()
    set(_cached_command "${CMAKE_COMMAND};-E;env;CCACHE_DEPEND=1")
    _ppu_append(_cached_command "CCACHE_PREFIX=${PPU_ELEMENTWISE_PREFIX}")
    _ppu_append(_cached_command "CCACHE_EXTRAFILES=${_extras}")
    foreach(_arg IN LISTS _args)
      _ppu_append(_cached_command "${_arg}")
    endforeach()
    _ppu_execute(_status _cached_command FALSE)
    _ppu_finish("${_status}")
  else()
    _ppu_run_staged(_command)
  endif()
else()
  _ppu_run_staged(_command)
endif()
